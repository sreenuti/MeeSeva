# Shared / docker-compose
ENVIRONMENT=development
AUTH_MODE=dev
AUTH_DEV_MODE=true
AUTH_DEV_JWT_SECRET=dev-only-change-me-use-32b-min

# Amazon Cognito (required when AUTH_MODE=cognito)
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_MFA_REQUIRED=true

# Database
DATABASE_URL=postgresql+psycopg://citizen:citizen@localhost:5432/citizen_services

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/vault
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_KMS_KEY_ID=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_COGNITO_REGION=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=
